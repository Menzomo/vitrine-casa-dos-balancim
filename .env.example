# Supabase — Project Settings > API no dashboard do projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secreta — ignora RLS, nunca usar no client, nunca commitar o valor real
# (Project Settings > API Keys > "Copy secret key")
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: só usada pelo Supabase CLI para aplicar migrations
# (supabase db push), o app em si não lê essa variável
SUPABASE_DB_PASSWORD=

# Mercado Livre (DevCenter) — usado a partir da etapa 3 (OAuth)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
